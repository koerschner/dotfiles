{
 "_doc": "ag-dash's keyboard shortcuts (spec: rule.md beside this). Actions and `when`s are defined in ag's ag-dash/dot-local/share/ag-dash/chat.html (search keyActions); format: keys.js there.",
 "bindings": [
  { "keys": "shift+cmd+o", "do": "newChat", "label": "New chat", "group": "Anywhere" },
  { "keys": "cmd+k", "do": "toggleSearch", "label": "Search chats" },
  { "keys": ["shift+cmd+s", "cmd+\\"], "do": "toggleSidebar", "label": "Toggle sidebar" },
  { "keys": ["alt+down", "alt+up"], "do": "stepChatKey", "label": "Next / previous chat" },
  { "keys": "shift+esc", "do": "focusBox", "label": "Focus the message box" },
  { "keys": "enter", "when": "composer", "do": "send", "label": "Send" },
  { "keys": "shift+enter", "when": "composer", "label": "New line" },
  { "keys": "alt+enter", "when": "composer", "do": "send" },
  { "keys": "cmd+enter", "when": "composer", "do": "sendPin", "label": "Send and pin the chat" },
  { "keys": "alt+cmd+enter", "when": "composer", "do": "interruptSend", "label": "Interrupt and send" },
  { "keys": "esc", "when": "composer", "do": "leaveBox", "label": "Leave the message box" },
  { "keys": "shift+cmd+c", "do": "copyLast", "label": "Copy last response" },
  { "keys": "alt+v", "do": "dictate", "label": "Dictate" },
  { "keys": "shift+cmd+m", "do": "move", "label": "Move chat to a project" },
  { "keys": ["shift+cmd+backspace", "shift+cmd+delete"], "do": "archiveNow", "label": "Archive chat" },
  { "keys": "shift+cmd+p", "do": "togglePin", "label": "Pin / unpin" },
  { "keys": "cmd+z", "do": "undoKey", "label": "Undo (archive, move)" },
  { "keys": "cmd+/", "do": "toggleShortcuts", "label": "Show shortcuts" },
  { "keys": "r", "when": "gmail", "do": "reply", "label": "Write a reply", "note": "Esc leaves the box", "group": "Gmail keys (outside the message box)" },
  { "keys": ["j", "k"], "when": "gmail", "do": "stepChatKey", "label": "Next / previous chat" },
  { "keys": "e", "when": "gmail", "do": "archiveNext", "label": "Archive and open the next chat" },
  { "keys": "z", "when": "gmail", "do": "undo", "label": "Undo (archive, move)" },
  { "keys": "c", "when": "gmail", "do": "newChat", "label": "New chat" },
  { "keys": "esc", "do": "escape", "label": "Unselect the chat" },
  { "keys": "u", "when": "gmail", "do": "undoKey", "label": "Undo, while an Undo toast is up (vim's u)" },
  { "keys": "u", "when": "gmail", "do": "needsYou", "label": "Back to Needs you (otherwise)" },
  { "keys": "shift+u", "when": "gmail", "do": "markUnread", "label": "Mark unread" },
  { "keys": "v", "when": "gmail", "do": "move", "label": "Move to a project" },
  { "keys": ".", "when": "gmail", "do": "moreActions", "label": "More actions" },
  { "keys": "/", "when": "gmail", "do": "search", "label": "Search" },
  { "keys": "?", "when": "gmail", "do": "toggleShortcuts", "label": "Show shortcuts" }
 ]
}
