# Shared SSH config (stowed from dotfiles). Machine-specific hosts go in ~/.ssh/config.local.
Include ~/.ssh/config.local

# ag-mac: the Mac half of Ag (the extremity: computer use, Mac-only apps and CLIs). Tailscale IP.
# `ag` is its old name, kept as an alias during the rename (2026-09-29); drop it once nothing uses it.
# The engine reaches it with its own key (~/.ssh/ag-mac, from ag-vault "ag-engine → ag-mac SSH key";
# authorized on ag-mac only from tailnet IPs; the Match adds it only where it exists, so other machines
# don't warn); other machines use id_ed25519.
# Used by `mac` (Mac-only commands, computer use, files), the engine's MCP tunnel, and the client's
# shot/show.
Match host ag-mac,ag exec "test -f ~/.ssh/ag-mac"
    IdentityFile ~/.ssh/ag-mac

Host ag-mac ag
    HostName 100.107.192.32
    User natkoersch
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 15
    ServerAliveCountMax 3
    # Reuse one connection (instant Cmd+V image paste, shot/show). Socket dir: ~/.ssh/sockets.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 4h

# ag-client: the Mac where Nathan sits. ag-mac uses this for ag-shot/ag-show/ag-client-cua.
# `nathan-dev-client` is its old name, kept as an alias during the rename (2026-09-29).
# The engine reaches the client with the same key it uses for ag-mac (authorized there from tailnet IPs):
# ag-presence polling and ag-show/ag-shot once sessions live on the engine.
Match host ag-client,nathan-dev-client exec "test -f ~/.ssh/ag-mac"
    IdentityFile ~/.ssh/ag-mac

Host ag-client nathan-dev-client
    HostName 100.68.116.104
    StrictHostKeyChecking accept-new
    User nathan
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 4h

# Ag engine (Hetzner, rebuilt by ag-infra; Tailscale IP changes on rebuild, so use MagicDNS).
Host ag-engine
    HostName ag-engine.tail44736d.ts.net
    User nathan
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 4h
