##########
# oh-my-zsh
##########

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

##########
# HISTORY
##########

HISTFILE=$HOME/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY
setopt HIST_VERIFY
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history.
setopt HIST_IGNORE_DUPS          # Dont record an entry that was just recorded again.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found.
setopt HIST_IGNORE_SPACE         # Dont record an entry starting with a space.
setopt HIST_SAVE_NO_DUPS         # Dont write duplicate entries in the history file.
setopt inc_append_history
setopt share_history

##########
# KEYBINDINGS (vi mode)
##########

bindkey -v
bindkey -M vicmd "k" up-line-or-beginning-search
bindkey -M vicmd "j" down-line-or-beginning-search
bindkey '^P' up-line-or-beginning-search
bindkey '^N' down-line-or-beginning-search

# edit command line with $EDITOR from vi normal mode or Ctrl-X Ctrl-E
autoload -U edit-command-line
zle -N edit-command-line
bindkey -M vicmd v edit-command-line
bindkey -M vicmd 'b' vi-backward-word
bindkey '^X^E' edit-command-line
bindkey "ç" fzf-cd-widget # step around mac default alt + c

##########
# ENV / PATH
##########

export EDITOR=nvim

export PATH="/opt/homebrew/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# mise manages project-pinned tool versions (including Bun).
# Keep this after Bun's PATH entry so mise's shims take precedence for `bun`,
# while commands installed in ~/.bun/bin (like `omp`) remain available.
eval "$(mise activate zsh)"

##########
# ALIASES
##########

alias v="nvim"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"

##########
# FUNCTIONS
##########

# Run a command and tint the tmux pane when it finishes until the pane is focused.
ringpane() {
  "$@"
  local rc=$?

  if [[ -n "$TMUX" ]] && command -v tmux >/dev/null 2>&1; then
    tmux set-option -p @rang 1
    tmux set-option -p window-style 'bg=colour240'
  fi

  return $rc
}

# Git worktrees
#
# Create a new branch as a worktree in ../<repo>-<branch> and cd into it
gw() {
  if [ -z "$1" ]; then
    echo "Usage: gw <branch-name>"
    return 1
  fi

  branch=$1
  repo=$(basename "$(git rev-parse --show-toplevel)")
  dir="../${repo}-${branch}"

  git worktree add "$dir" -b "$branch" && cd "$dir"
}

# Merge current worktree branch into main, clean up, and cd to main repo
# Can be run from the worktree (no args) or from main with a branch name
gwm() {
  local branch dir main_dir

  if [ -n "$1" ]; then
    branch=$1
    repo=$(basename "$(git rev-parse --show-toplevel)")
    dir="../${repo}-${branch}"
    main_dir="."
  else
    branch=$(git branch --show-current)
    dir=$(git rev-parse --show-toplevel)
    main_dir=$(git rev-parse --path-format=absolute --git-common-dir | sed 's|/\.git$||')

    if [ "$dir" = "$main_dir" ]; then
      echo "Error: already on main repo. Usage: gwm [branch-name]"
      return 1
    fi
  fi

  # Commit any uncommitted changes on the worktree branch before switching
  if ! git diff --quiet || ! git diff --cached --quiet; then
    git add -A && git commit -m "WIP: uncommitted changes from $branch" || return 1
  fi

  local default_branch
  default_branch=$(cd "$main_dir" && git branch -l main master 2>/dev/null | head -1 | tr -d '* ')

  # Stash any uncommitted changes on the default branch
  cd "$main_dir" || return 1
  local stashed=false
  if ! git diff --quiet || ! git diff --cached --quiet; then
    git stash && stashed=true
  fi

  git checkout "$default_branch" &&
  git pull || true

  if git merge "$branch"; then
    git worktree remove "$dir" 2>/dev/null
    git branch -d "$branch"
    $stashed && git stash pop
  else
    echo "Merge conflicts detected. Resolve them, then run:"
    echo "  git worktree remove $dir && git branch -d $branch"
    $stashed && git stash pop
  fi
}

##########
# MACHINE-LOCAL / AI GATEWAY
##########

# Machine-local secrets and overrides. Kept outside this repo so tokens are
# never committed; see ~/.zshenv.local.
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local

# Opt this machine into TrueFoundry by defining TFY_TOKEN in ~/.zshenv.local.
# Machines without that local token keep each tool's standard OAuth/API auth.
# Pi's model config lives solely in ~/.pi/agent/settings.json.
# Codex / ChatGPT desktop read TFY_API_KEY (env_key in ~/.codex/config.toml,
# where model_provider = "tfy" is set). GUI apps get it via the
# com.nathan.ag-tfy-env LaunchAgent (see ~/dotfiles/macos), not from this file.
if [[ -n ${TFY_TOKEN:-} ]]; then
  export TFY_API_KEY="$TFY_TOKEN"
  export ANTHROPIC_BASE_URL="https://tfy.promptlens.trilogy.com"
  export ANTHROPIC_AUTH_TOKEN="$TFY_TOKEN"
  export ANTHROPIC_MODEL="claude-fable-5-1[1m]"
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
